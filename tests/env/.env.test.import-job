# Stage 4.5 / Step 7 — import-job profile. Same flag set as realtime-ws
# (we need WS to subscribe to `import_jobs` realtime events) plus this is
# the profile under which Step 7 / Step 8 specs drive end-to-end multipart
# upload + ImportJob worker. Backend env knobs (IMPORT_JOB_ENABLED,
# BLOB_STORE_KIND=local-fs) live in the backend-start.sh wrapper, not here
# — these are *frontend* build vars only.
DEXIE_DB_URL=
BACKEND_DATA_API_URL=http://127.0.0.1:9011
BACKEND_AUTH=true
BACKEND_DATA_TABLES=providers,reactives,assistants,installedPlugins,avatarImages,workspaces,dialogs,items,artifacts,messages
REALTIME_TRANSPORT=ws
EXPOSE_DB=true
