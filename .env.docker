# S3 / Cloudflare R2 — 在 VPS 的 .env 里填真实值
S3_ENDPOINT=https://<账户ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://你的R2公开域名
S3_ACCESS_KEY=你的R2_Access_Key_ID
S3_SECRET_KEY=你的R2_Secret_Access_Key
S3_BUCKET=aiaw
S3_REGION=auto
