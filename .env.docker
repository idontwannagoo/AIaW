DOC_PARSE_BASE_URL=/doc-parse
CORS_FETCH_BASE_URL=/cors
SEARXNG_BASE_URL=/searxng
DEXIE_DB_URL=https://znm3rqzc8.dexie.cloud

# ────────────────────────────────────────────────────────────────────────
# Stage 1+ 前端 backend flag（按 plan 灰度顺序逐档放开）
#
# 这些是 quasar build 期内联到 JS bundle 的，改这里必须 git push 触发
# Northflank 重新构建。后端 runtime env（JWT_SECRET / DATABASE_URL /
# BACKEND_DATA_API_ENABLED / ALLOW_REGISTRATION 等）在 Northflank 控制台
# 直接改即可，**绝不**写进本文件，否则会泄露到前端 JS。
#
# 默认全注释 = 行为字节级等同 my-deploy 老用户路径。每档独立可逐个开。
# ────────────────────────────────────────────────────────────────────────
#
# ── 第 1 档：双登录入口 + http.ts 启用 ──（已开 2026-05-02）
# AccountPage 出现 "Backend Login" 入口；http.ts 用页面同域名调 backend；
# providers 表仍走 Dexie（第 2 档才切）。
BACKEND_DATA_API_URL=
BACKEND_AUTH=true
#
# ── 第 2 档：providers 表切到 backend ──
# 取消注释 → providers 表 CRUD 走 /api/v1/providers，IndexedDB 退化为缓存。
# CSV 形式可加更多表（如 'providers,reactives'），但 Stage 3+ 表逐张落地。
# BACKEND_DATA_TABLES=providers
#
# ── 第 3 档：实时通道开 ──
# 取消注释 → 双 tab 实时联动；'auto' 先试 ws，被代理拦掉自动降级 sse / poll。
# 也可固定档：'ws' / 'sse' / 'poll'。
# REALTIME_TRANSPORT=auto
