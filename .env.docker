DOC_PARSE_BASE_URL=/doc-parse
CORS_FETCH_BASE_URL=/cors
SEARXNG_BASE_URL=/searxng
# new-deploy 是空库新版独立实例，迁移路径 = 老用户在 my-deploy 导出 →
# 新版 ImportDataDialog 导入。new-deploy 自始至终不连原 Dexie SaaS：
# 留空则 dexieAuthSource.enabled=false → AccountPage 双登录入口隐藏 →
# dexie-cloud-addon 不挂载 → IndexedDB 退回纯本地缓存。详见 plan
# 「2026-05-XX · Stage 2.5 摘双登录 + dexie-cloud-addon 前置清理」修订记录。
DEXIE_DB_URL=

# ────────────────────────────────────────────────────────────────────────
# Stage 1+ 前端 backend flag（按 plan 灰度顺序逐档放开）
#
# 这些是 quasar build 期内联到 JS bundle 的，改这里必须 git push 触发
# Northflank 重新构建。后端 runtime env（JWT_SECRET / DATABASE_URL /
# BACKEND_DATA_API_ENABLED / ALLOW_REGISTRATION 等）在 Northflank 控制台
# 直接改即可，**绝不**写进本文件，否则会泄露到前端 JS。
#
# 默认全注释 = 行为字节级等同 my-deploy 老用户路径。每档独立可逐个开。
# ────────────────────────────────────────────────────────────────────────
#
# ── 第 1 档：自家 JWT 鉴权 + http.ts 启用 ──（已开 2026-05-02）
# AccountPage 走 BackendLoginDialog；http.ts 调本服务自身的 backend。
# 注意：BACKEND_DATA_API_URL 必须是非空 URL，不支持留空——`http.ts:26` 是
# truthy check (`!BackendApiBaseURL`)，空字符串会让任何 fetch 在 buildUrl
# 阶段 throw。Northflank 单容器架构下填 service 自己的公网域名即可。
# 以后绑自定义域名时同步改这里再 push。
# providers 表仍走 Dexie（第 2 档才切）。
BACKEND_DATA_API_URL=https://p01--new-aiaw--hqdb2bsvdnbt.code.run
BACKEND_AUTH=true
#
# ── 第 2 档：providers / reactives / assistants / installedPlugins / avatarImages 表切到 backend ──
# 列表里每张表都走 /api/v1/<table>，IndexedDB 退化为缓存。
#   - providers: 2026-05-02 开（Stage 2 收官）
#   - reactives: 2026-05-02 开（Stage 3 / 批次-3a，KV 形 endpoint）
#   - assistants / installedPlugins / avatarImages: 2026-05-02 开
#     （Stage 3 / 批次-3b，3 张叶子表合一批 — 名字用前端 camelCase 与
#      `repos.*` 属性同名；后端 endpoint 仍是 snake_case `installed-plugins`
#      / `avatar-images`，转换在各自 server.ts 内）
# Stage 4+（workspaces / dialogs / items / artifacts / messages）落地时
# 同一批 commit 内继续追加。
BACKEND_DATA_TABLES=providers,reactives,assistants,installedPlugins,avatarImages,workspaces
#
# ── 第 3 档：实时通道开 ──（已开 2026-05-02）
# 双 tab 实时联动；'auto' 先试 ws，被代理拦掉自动降级 sse / poll。
# 也可固定档：'ws' / 'sse' / 'poll'。
REALTIME_TRANSPORT=auto
